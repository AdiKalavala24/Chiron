# Copy this file to .env and fill in a real key to enable Gemini-powered
# "more practice" lesson generation and the parent narrative debrief.
# Without it, the app runs entirely on the hardcoded 20-path curriculum
# and a templated offline debrief (see src/features/gemini/*-generator.ts
# for the fail-soft fallback behavior) — nothing crashes if this is unset.
#
# Get a key at https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional — override the default model without touching code.
# EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
